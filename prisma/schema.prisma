// Prisma schema for the multi-user stock tracker.
// Provider: PostgreSQL (works with Supabase or Neon).
//
// `url`       — the connection string the app uses at runtime (POOLED).
// `directUrl` — the DIRECT (non-pooled) connection used by `prisma db push` /
//               migrations.
//
// `neon link` / `neon deploy` pull these into .env.local as DATABASE_URL
// (pooled) and DATABASE_URL_UNPOOLED (direct), so we map directUrl to the
// unpooled var Neon provides.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // maps to the Clerk user id
  email     String?
  username  String   @unique // display handle, derived from Clerk (collision-safe)
  name      String // display name
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions Position[]
}

model ChipDistributionSnapshot {
  id                   String   @id @default(cuid())
  symbol               String
  market               String // 'US' | 'JP' | 'TW'
  reportDate           DateTime
  bigHolderPct         Float // % held by institutions / >5% / big tier
  retailHolderPct      Float // % held by retail / small tier
  insiderNetShares     Float // net insider buy(+)/sell(-) shares
  marginRatio          Float? // 信用倍率 or short interest %
  institutionalNetFlow Float? // 法人買賣超 or ETF net flow
  rawTierData          Json? // full bracket breakdown + AI interpretation
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([symbol, reportDate])
  @@index([symbol])
}

model DailyAnalysis {
  id              String   @id @default(cuid())
  symbol          String
  date            String // YYYY-MM-DD (UTC) — one analysis per ticker per day
  driver          String // 'Macro' | 'Micro' | 'Both'
  summary         String
  longTermOutlook String
  trajectoryType  String // 'Transitory Noise' | 'Structural Shift'
  updatedAt       DateTime @updatedAt

  // Generate (and pay for) an analysis only once per ticker per day.
  @@unique([symbol, date])
}

model Position {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  shares    Float
  buyPrice  Float
  // Optional manual price override (in the ticker's native currency), used when
  // live quotes are unavailable (e.g. foreign tickers like 4044.T). Null = use
  // live quotes.
  manualPrice Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per (user, ticker); adding more shares merges via weighted average.
  @@unique([userId, symbol])
  @@index([userId])
}
