# ─────────────────────────────────────────────────────────────
# Stock Portfolio Tracker — Environment Variables
# Copy this file to `.env.local` and fill in your key(s).
# `.env.local` is git-ignored and NEVER shipped to the browser.
# ─────────────────────────────────────────────────────────────

# Finnhub (default provider) — free tier: 60 API calls/minute
# Get a free key at: https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── Optional: Polygon.io ─────────────────────────────────────
# If you prefer Polygon, set PRICE_PROVIDER=polygon and add your key.
# Free tier at: https://polygon.io/  (5 calls/minute on the free plan)
# PRICE_PROVIDER=finnhub
# POLYGON_API_KEY=your_polygon_api_key_here

# ── Optional: Twelve Data (international equities) ────────────
# Used as the price source for foreign tickers (e.g. 4044.T / Tokyo), which
# Yahoo throttles from cloud IPs. Free tier covers US + FX; most foreign
# exchanges (incl. Tokyo/JPX) require a paid Pro/Venture plan.
# Get a key at: https://twelvedata.com/
# TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# ── Client polling interval for live prices (milliseconds) ───
# Keep >= 15000 on Finnhub free tier to stay within rate limits.
NEXT_PUBLIC_PRICE_POLL_MS=15000

# ─────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL — Supabase or Neon)
# ─────────────────────────────────────────────────────────────
# DATABASE_URL = pooled connection used by the app at runtime.
# DIRECT_URL   = direct (non-pooled) connection used by `prisma db push`
#                / migrations. On Supabase/Neon these are two different URLs.
#
# Supabase: Project → Settings → Database → Connection string
#   - DATABASE_URL: "Transaction" pooler (port 6543), add ?pgbouncer=true
#   - DIRECT_URL:   "Session"/direct connection (port 5432)
# Neon: Dashboard → Connection Details
#   - DATABASE_URL: the "Pooled connection" string
#   - DIRECT_URL:   the "Direct connection" string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ─────────────────────────────────────────────────────────────
# AUTHENTICATION (Clerk)
# ─────────────────────────────────────────────────────────────
# Create a free app at https://dashboard.clerk.com → API Keys.
# The publishable key is safe for the browser (NEXT_PUBLIC_*); the secret key
# must stay server-side.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
